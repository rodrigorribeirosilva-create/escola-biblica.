# Configuração pública do cliente web (Vite).
# A publishable key pode aparecer no navegador; proteja os dados com RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NÃO adicione aqui SUPABASE_SECRET_KEYS, SUPABASE_SECRET_KEY ou service_role.
# Chaves secretas são usadas somente pelo runtime das Edge Functions do Supabase.
